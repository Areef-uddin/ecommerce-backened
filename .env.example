# ==============================================================================
# StyleHub Luxe - Backend Environment Variables Configuration
# Copy this file to .env and replace placeholder values with your real keys.
# On Render: Add these under "Environment Variables" in your Web Service dashboard.
# ==============================================================================

# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=your-secure-random-django-secret-key-min-50-characters

# Set to False in production on Render!
DEBUG=False

# Comma-separated list of allowed hostnames (e.g., your-app.onrender.com,localhost,127.0.0.1)
ALLOWED_HOSTS=your-app-name.onrender.com,127.0.0.1,localhost

# Database Connection URL (PostgreSQL / Neon / Render Postgres)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Twilio Verify v2 Credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# OpenRouter AI Virtual Try-On API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# CORS Configuration
# Set to False in production if you want to restrict to specific frontends
CORS_ALLOW_ALL=True
# Or specify allowed origins separated by commas:
# CORS_ALLOWED_ORIGINS=https://stylehub-admin.onrender.com,https://stylehub.com
